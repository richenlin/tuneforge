{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuneforge",
  "version": "0.1.0",
  "identifier": "com.tuneforge.app",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tuneforge — 音频处理工具",
        "width": 1360,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "Utility",
    "shortDescription": "无损音频转换 / 重命名 / 归一化 / 标签工具",
    "longDescription": "Tuneforge 基于捆绑的 FFmpeg 与 Rust DSP 实现格式转换、文件名标准化、EBU R128 音量归一化（真峰值限幅）与标签元素编辑；所有操作只读源文件，结果输出到新文件夹。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": ["licenses/*"],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
